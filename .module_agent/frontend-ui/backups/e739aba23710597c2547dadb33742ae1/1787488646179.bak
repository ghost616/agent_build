describe('useEvaluationExecute 统一日志数组 logLinesRef', () => {
  it('应声明 logLinesRef 持有统一日志数组', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('const logLinesRef = useRef<string[]>([])');
    expect(source).toContain('执行流程与 WebSocket 回调共用同一引用');
  });

  it('每次 execute 开始应重置 logLinesRef 与前台日志', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('logLinesRef.current = [];');
    expect(source).toContain('setForegroundLog([])');
  });

  it('pushLog 应写入 logLinesRef.current 并同步 setForegroundLog', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('logLinesRef.current.push(...lines)');
    expect(source).toContain('setForegroundLog([...logLinesRef.current])');
  });

  it('appendStreamText 应基于 logLinesRef.current 续接或新建日志行', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('const logLines = logLinesRef.current;');
    expect(source).toContain("last?.startsWith(prefix)");
  });
});

describe('useEvaluationExecute 执行逻辑', () => {
  it('BACKGROUND 模式应调 executeEvaluation 并连接流式接口', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain("executionType === 'BACKGROUND'");
    expect(source).toContain('executeEvaluation(evaluationId)');
    expect(source).toContain('executionSessionId');
    expect(source).toContain('getEvaluationStream');
  });

  it('BACKGROUND 模式先调用 status 接口判断 hasCache', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('while (hasCache && executingRef.current)');
    expect(source).toContain('getEvaluationCacheStatus(executionSessionId)');
    expect(source).toContain('hasCache = cacheStatus.hasCache');
  });

  it('BACKGROUND 模式 hasCache 为 true 时用 cacheId 连接 stream', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('streamEvaluation(cacheStatus.cacheId)');
    expect(source).toContain('!hasCache || !cacheStatus.cacheId');
  });

  it('BACKGROUND 模式 stream 结束后应 remove cache 再回到 status 循环', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('removeEvaluationCache(cacheStatus.cacheId)');
    expect(source).toContain('streamEvaluation(cacheStatus.cacheId)');
    expect(source).toContain('getEvaluationCacheStatus(executionSessionId)');
  });

  it('FOREGROUND 模式应创建会话然后逐条发送消息', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('createEvalSession(evaluationId)');
    expect(source).toContain('evalSession.userMessages');
    expect(source).toContain('sendForegroundMessage');
  });

  it('FOREGROUND 模式最后应生成评估结果', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('generateEvalResult(evaluationId, evalSession.sessionId)');
  });

  it('FOREGROUND 模式生成结果后应轮询 getGenerateStatus', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('pollGenerateStatus(evaluationId, evalSession.sessionId)');
  });

  it('pollGenerateStatus 应检查 completed 和 failed 状态', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain("status.status.toUpperCase() === 'COMPLETED'");
    expect(source).toContain("status.status.toUpperCase() === 'FAILED'");
  });

  it('BACKGROUND 模式应按 executionCount 循环执行', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('for (let i = 0; i < evaluation.executionCount; i++)');
  });

  it('BACKGROUND 模式每次循环应显示第 i/N 次进度', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('执行中(第 ${i + 1}/${evaluation.executionCount} 次)...');
  });

  it('FOREGROUND 模式应按 executionCount 循环执行', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('for (let i = 0; i < evaluation.executionCount; i++)');
  });

  it('FOREGROUND 模式每次循环应显示第 i/N 次分隔', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('========== 第 ${i + 1}/${evaluation.executionCount} 次执行 ==========');
  });
});

describe('useEvaluationExecute FOREGROUND conversationId (静态验证)', () => {
  it('sendForegroundMessage 应在调用 agentChatStream 前 await fetchConversationId()', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const sendBlock = source.match(/const sendForegroundMessage[\s\S]*?\}\s*,\s*\[appendStreamText, runToolCycle\]\s*,?\s*\)\s*;/);
    expect(sendBlock).not.toBeNull();
    if (sendBlock) {
      expect(sendBlock[0]).toContain('conversationId = await fetchConversationId();');
      expect(sendBlock[0]).toContain('agentChatStream(');
    }
  });

  it('sendForegroundMessage 应把 conversationId 传入 agentChatStream 请求参数', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const sendBlock = source.match(/const sendForegroundMessage[\s\S]*?\}\s*,\s*\[appendStreamText, runToolCycle\]\s*,?\s*\)\s*;/);
    expect(sendBlock).not.toBeNull();
    if (sendBlock) {
      expect(sendBlock[0]).toContain('{ sessionId, content, conversationId }');
    }
  });

  it('sendForegroundMessage 获取 conversationId 失败时应抛出错误', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain("throw new Error('获取会话标识失败')");
  });

  it('sendForegroundMessage 应以 loadingRef 标记执行会话对话进行中', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const sendBlock = source.match(/const sendForegroundMessage[\s\S]*?\}\s*,\s*\[appendStreamText, runToolCycle\]\s*,?\s*\)\s*;/);
    expect(sendBlock).not.toBeNull();
    if (sendBlock) {
      expect(sendBlock[0]).toContain('loadingRef.current = true;');
      expect(sendBlock[0]).toContain('loadingRef.current = false;');
    }
  });
});

describe('useEvaluationExecute runToolCycle', () => {
  it('应存在 runToolCycle 独立函数', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('runToolCycle');
  });

  it('runToolCycle 应接收 toolLoopCount 对象（非原始数字）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('toolLoopCount: { current: number }');
  });

  it('runToolCycle 应在超出最大循环次数时返回', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('toolLoopCount.current >= maxToolLoops');
  });

  it('hasMore 分支中应更新 currentResult = nextExec', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('currentResult = nextExec');
  });

  it('runToolCycle 中 continueChatStream 的 onDone 应递归调用自身', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('await runToolCycle(sessionId, toolLoopCount, maxToolLoops)');
  });

  it('应包含 sendForegroundMessage 函数，支持工具调用循环', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('sendForegroundMessage');
    expect(source).toContain('MAX_TOOL_LOOPS');
    expect(source).toContain('executeTools(sessionId)');
    expect(source).toContain('getToolStatus(');
    expect(source).toContain('continueChatStream(');
  });

  it('runToolCycle 应以 toolExecutingRef 标记工具循环进行中', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('toolExecutingRef.current = true;');
    expect(source).toContain('toolExecutingRef.current = false;');
  });

  it('runToolCycle 检测 needsSubSessionFlow 时应获取子会话数据后以统一参数调用 handleSubSessionFlow', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const runBlock = source.match(/const runToolCycle[\s\S]*?\n    \[appendStreamText, handleSubSessionFlow, pushLog\],\n  \);/);
    expect(runBlock).not.toBeNull();
    if (runBlock) {
      expect(runBlock[0]).toContain('toolStatus.needsSubSessionFlow');
      expect(runBlock[0]).toContain('getSubSessionData(sessionId)');
      expect(runBlock[0]).toContain('handleSubSessionFlow({');
      expect(runBlock[0]).toContain('childId: data.childSessionId');
      expect(runBlock[0]).toContain('streamContent: data.userMessage');
      expect(runBlock[0]).toContain('fromWs: false');
    }
  });
});

describe('useEvaluationExecute handleSubSessionFlow (统一参数)', () => {
  it('应存在 handleSubSessionFlow 函数', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('handleSubSessionFlow');
  });

  it('handleSubSessionFlow 应使用统一参数 childId/userContent/streamContent/thinking/fromWs', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const subBlock = source.match(/interface SubSessionFlowParams \{[\s\S]*?\}/);
    expect(subBlock).not.toBeNull();
    if (subBlock) {
      expect(subBlock[0]).toContain('childId');
      expect(subBlock[0]).toContain('userContent');
      expect(subBlock[0]).toContain('streamContent');
      expect(subBlock[0]).toContain('thinking');
      expect(subBlock[0]).toContain('fromWs');
    }
    const flowBlock = source.match(/const handleSubSessionFlow = useCallback\([\s\S]*?\n    \[appendStreamText, pushLog\],\n  \);/);
    expect(flowBlock).not.toBeNull();
    if (flowBlock) {
      expect(flowBlock[0]).toContain('const { childId, userContent, streamContent, thinking, fromWs } = params;');
    }
  });

  it('handleSubSessionFlow 应使用子会话 childId 调用 agentChatStream', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('childId');
    expect(source).toContain('agentChatStream(');
  });

  it('handleSubSessionFlow 应包含子会话工具轮询 pollSubToolStatus', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('pollSubToolStatus');
    expect(source).toContain('getToolStatus(');
  });

  it('handleSubSessionFlow 应循环 sendMessage → runSubTools → continueSubChat（完整复用工具循环）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const flowBlock = source.match(/const handleSubSessionFlow = useCallback\([\s\S]*?\n    \[appendStreamText, pushLog\],\n  \);/);
    expect(flowBlock).not.toBeNull();
    if (flowBlock) {
      expect(flowBlock[0]).toContain('let hasToolCalls = await sendSubMessage(streamContent);');
      expect(flowBlock[0]).toContain('hasToolCalls = await continueSubChat();');
      expect(flowBlock[0]).toContain('const ok = await runSubTools();');
    }
  });

  it('fromWs=true 时应跳过 completeSubSession（WS 触发收尾守卫）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const flowBlock = source.match(/const handleSubSessionFlow = useCallback\([\s\S]*?\n    \[appendStreamText, pushLog\],\n  \);/);
    expect(flowBlock).not.toBeNull();
    if (flowBlock) {
      expect(flowBlock[0]).toContain('if (!fromWs) {');
      expect(flowBlock[0]).toContain('completeSubSession(parentSessionId)');
      expect(flowBlock[0]).toContain('消息已由后端保存');
    }
  });

  it('工具触发（fromWs=false）时应展示用户消息日志', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const flowBlock = source.match(/const handleSubSessionFlow = useCallback\([\s\S]*?\n    \[appendStreamText, pushLog\],\n  \);/);
    expect(flowBlock).not.toBeNull();
    if (flowBlock) {
      expect(flowBlock[0]).toContain("if (!fromWs) {");
      expect(flowBlock[0]).toContain('`[子会话] 用户消息: ${userContent}`');
    }
  });

  it('同一子会话已有流程进行中时应忽略（activeChildIdsRef 去重）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('const activeChildIdsRef = useRef<Set<string>>(new Set())');
    expect(source).toContain('activeChildIdsRef.current.has(childId)');
    expect(source).toContain('activeChildIdsRef.current.add(childId)');
    expect(source).toContain('activeChildIdsRef.current.delete(childId)');
  });
});

describe('useEvaluationExecute WebSocket 消息分发处理器', () => {
  it('FOREGROUND 创建执行会话后应注册 handler（以 executionSessionId 为主会话）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const registerBlock = source.match(/const registerEvaluationHandler = useCallback\([\s\S]*?\n  \}, \[\]\);/);
    expect(registerBlock).not.toBeNull();
    if (registerBlock) {
      expect(registerBlock[0]).toContain('mainSessionId: executionSessionId');
      expect(registerBlock[0]).toContain('streamChildReply');
      expect(registerBlock[0]).toContain('onSessionMessage');
      expect(registerBlock[0]).toContain('registerSessionPage(handler)');
    }
    expect(source).toContain('registerEvaluationHandler(evalSession.sessionId)');
  });

  it('重复执行时应先注销旧执行会话的 handler', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const registerBlock = source.match(/const registerEvaluationHandler = useCallback\([\s\S]*?\n  \}, \[\]\);/);
    expect(registerBlock).not.toBeNull();
    if (registerBlock) {
      expect(registerBlock[0]).toContain('unregisterSessionPage(executionSessionIdRef.current)');
      expect(registerBlock[0]).toContain('executionSessionIdRef.current !== executionSessionId');
    }
  });

  it('execute finally 应注销 handler（执行结束）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const executeBlock = source.match(/const execute = useCallback\([\s\S]*?\n    \[/);
    expect(executeBlock).not.toBeNull();
    if (executeBlock) {
      expect(executeBlock[0]).toContain('unregisterEvaluationHandler();');
      expect(executeBlock[0]).toContain('// 执行结束注销 WebSocket 消息分发处理器');
    }
  });

  it('handleCancelForeground 应注销 handler（取消执行）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const cancelBlock = source.match(/const handleCancelForeground[\s\S]*?\n  \};/);
    expect(cancelBlock).not.toBeNull();
    if (cancelBlock) {
      expect(cancelBlock[0]).toContain('unregisterEvaluationHandler();');
      expect(cancelBlock[0]).toContain('// 取消执行注销 WebSocket 消息分发处理器');
    }
  });

  it('组件卸载时 useEffect cleanup 应注销 handler（前台执行未运行时无 handler）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('useEffect(() => {');
    expect(source).toContain('return () => {');
    expect(source).toContain('unregisterEvaluationHandler();');
    expect(source).toContain('// 组件卸载时注销处理器');
  });

  it('unregisterEvaluationHandler 应在注销后清空 executionSessionIdRef', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const unregisterBlock = source.match(/const unregisterEvaluationHandler = useCallback\([\s\S]*?\n  \}, \[\]\);/);
    expect(unregisterBlock).not.toBeNull();
    if (unregisterBlock) {
      expect(unregisterBlock[0]).toContain('unregisterSessionPage(executionSessionId)');
      expect(unregisterBlock[0]).toContain('executionSessionIdRef.current = null;');
    }
  });
});

describe('useEvaluationExecute streamChildReply (主→子 WS 触发)', () => {
  it('应追加 [子会话] {content} 日志行', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const streamChildReply = useCallback\([\s\S]*?\n    \[pushLog, trackAsync\],\n  \);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('pushLog(`[子会话] ${content}`)');
    }
  });

  it('应以 SEND_USER_MESSAGE_MARKER + fromWs=true 触发 handleSubSessionFlow', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const streamChildReply = useCallback\([\s\S]*?\n    \[pushLog, trackAsync\],\n  \);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('streamContent: SEND_USER_MESSAGE_MARKER');
      expect(block[0]).toContain('fromWs: true');
      expect(block[0]).toContain('userContent: content');
      expect(block[0]).toContain('handleSubSessionFlowRef.current({');
    }
  });

  it('sessionId 为执行会话自身时应转由 onSessionMessage 处理', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const streamChildReply = useCallback\([\s\S]*?\n    \[pushLog, trackAsync\],\n  \);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('childId === executionSessionId');
      expect(block[0]).toContain('onSessionMessageRef.current(payload)');
    }
  });

  it('同一子会话流程进行中时应忽略新消息', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const streamChildReply = useCallback\([\s\S]*?\n    \[pushLog, trackAsync\],\n  \);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('activeChildIdsRef.current.has(childId)');
    }
  });
});

describe('useEvaluationExecute onSessionMessage (子→主 WS 回传)', () => {
  it('应追加 [子会话回传] {content} 日志行', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const onSessionMessage = useCallback\([\s\S]*?\n    \[pushLog, trackAsync\],\n  \);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('pushLog(`[子会话回传] ${payload.content || \'\'}`)');
    }
  });

  it('执行中（loading/toolExecuting）仅追加日志不触发续接', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const onSessionMessage = useCallback\([\s\S]*?\n    \[pushLog, trackAsync\],\n  \);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('if (loadingRef.current || toolExecutingRef.current) return;');
    }
  });

  it('空闲时以 continueEvaluationChat 触发 marker 续接', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const onSessionMessage = useCallback\([\s\S]*?\n    \[pushLog, trackAsync\],\n  \);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('continueEvaluationChatRef.current()');
    }
  });

  it('执行已结束（executingRef=false）时不触发续接', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const onSessionMessage = useCallback\([\s\S]*?\n    \[pushLog, trackAsync\],\n  \);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('if (!executingRef.current) return;');
    }
  });

  it('消息非执行会话自身时应转由 streamChildReply 处理', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const onSessionMessage = useCallback\([\s\S]*?\n    \[pushLog, trackAsync\],\n  \);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('targetId !== executionSessionIdRef.current');
      expect(block[0]).toContain('streamChildReplyRef.current(payload)');
    }
  });
});

describe('useEvaluationExecute continueEvaluationChat (marker 续接)', () => {
  it('应以 SEND_USER_MESSAGE_MARKER 调用 agentChatStream（不重复保存 user 消息）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const continueEvaluationChat = useCallback\([\s\S]*?\n  \}, \[appendStreamText, runToolCycle\]\);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('content: SEND_USER_MESSAGE_MARKER');
      expect(block[0]).toContain('agentChatStream(');
    }
  });

  it('流式回复应追加 [AI]/[思考] 日志行', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const continueEvaluationChat = useCallback\([\s\S]*?\n  \}, \[appendStreamText, runToolCycle\]\);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain("appendStreamText('[AI]', text)");
      expect(block[0]).toContain("appendStreamText('[思考]', text)");
    }
  });

  it('onDone 有工具调用时应进入主会话工具循环', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const continueEvaluationChat = useCallback\([\s\S]*?\n  \}, \[appendStreamText, runToolCycle\]\);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('await runToolCycle(sessionId, toolLoopCount, MAX_TOOL_LOOPS)');
    }
  });

  it('执行会话执行中/空闲守卫：loading 或 toolExecuting 时直接返回', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const continueEvaluationChat = useCallback\([\s\S]*?\n  \}, \[appendStreamText, runToolCycle\]\);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('if (loadingRef.current || toolExecutingRef.current) return;');
    }
  });
});

describe('useEvaluationExecute 异步活动跟踪 (pendingAsyncRef/trackAsync/waitForPendingAsync)', () => {
  it('应声明 pendingAsyncRef 跟踪 WS 触发的异步活动', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('const pendingAsyncRef = useRef<Set<Promise<void>>>(new Set())');
  });

  it('trackAsync 应将 promise 加入集合并在完成后移除', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const trackAsync = useCallback\([\s\S]*?\n  \}, \[\]\);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('pendingAsyncRef.current.add(promise)');
      expect(block[0]).toContain('pendingAsyncRef.current.delete(promise)');
      expect(block[0]).toContain('.finally(');
      expect(block[0]).toContain('return promise;');
    }
  });

  it('waitForPendingAsync 应循环等待集合清空（嵌套新增继续等待）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const waitForPendingAsync = useCallback\([\s\S]*?\n  \}, \[\]\);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('while (executingRef.current && pendingAsyncRef.current.size > 0)');
      expect(block[0]).toContain('Array.from(pendingAsyncRef.current)');
      expect(block[0]).toContain('Promise.all(pending)');
    }
  });

  it('waitForPendingAsync 应受 executingRef 控制（取消时立即退出，防死锁）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const waitForPendingAsync = useCallback\([\s\S]*?\n  \}, \[\]\);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('while (executingRef.current && pendingAsyncRef.current.size > 0)');
      expect(block[0]).toContain('每个跟踪 promise 最终完成');
    }
  });

  it('streamChildReply 应以 trackAsync 跟踪 WS 触发的子会话执行', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('trackAsync(handleSubSessionFlowRef.current({');
  });

  it('onSessionMessage 应以 trackAsync 跟踪 marker 续接', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('trackAsync(continueEvaluationChatRef.current())');
  });

  it('continueEvaluationChat 应返回 Promise<void>（改造为可等待）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const block = source.match(/const continueEvaluationChat = useCallback\([\s\S]*?\n  \}, \[appendStreamText, runToolCycle\]\);/);
    expect(block).not.toBeNull();
    if (block) {
      expect(block[0]).toContain('const continueEvaluationChat = useCallback(async (): Promise<void> =>');
      expect(block[0]).toContain('await new Promise<void>((resolve) => {');
    }
  });

  it('continueEvaluationChatRef 类型应为 () => Promise<void>', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('const continueEvaluationChatRef = useRef<() => Promise<void>>(async () => {})');
  });

  it('execute 每条消息 sendForegroundMessage 完成后应调用 waitForPendingAsync', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const execBlock = source.match(/const execute = useCallback\([\s\S]*?\n    \[/);
    expect(execBlock).not.toBeNull();
    if (execBlock) {
      expect(execBlock[0]).toContain('await sendForegroundMessage(evalSession.sessionId, msg);');
      expect(execBlock[0]).toContain('// 每条消息完成后等待 WebSocket 触发的子会话执行/续接完成');
      expect(execBlock[0]).toContain('await waitForPendingAsync();');
    }
  });

  it('execute 生成评估结果前应调用 waitForPendingAsync', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const execBlock = source.match(/const execute = useCallback\([\s\S]*?\n    \[/);
    expect(execBlock).not.toBeNull();
    if (execBlock) {
      expect(execBlock[0]).toContain('// 所有消息处理完、生成评估结果前等待 WebSocket 触发的异步活动清空');
      expect(execBlock[0]).toContain('await waitForPendingAsync();');
      expect(execBlock[0]).toContain("pushLog('\\n正在生成评估结果...')");
    }
  });

  it('execute 开始与 finally 应清理 pendingAsyncRef（重复执行重置）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const execBlock = source.match(/const execute = useCallback\([\s\S]*?\n    \[/);
    expect(execBlock).not.toBeNull();
    if (execBlock) {
      expect(execBlock[0]).toContain('pendingAsyncRef.current.clear();');
    }
  });

  it('handleCancelForeground 取消时应清空 pendingAsyncRef（立即退出等待）', () => {
    const source = readFileSync(hookPath, 'utf-8');
    const cancelBlock = source.match(/const handleCancelForeground[\s\S]*?\n  \};/);
    expect(cancelBlock).not.toBeNull();
    if (cancelBlock) {
      expect(cancelBlock[0]).toContain('pendingAsyncRef.current.clear();');
      expect(cancelBlock[0]).toContain('// 取消执行立即退出等待并清理 WS 触发的异步活动跟踪');
    }
  });
});

describe('useEvaluationExecute catch 异常分支', () => {
  it('catch 应检查 AbortError 并直接 return', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain("err instanceof DOMException && err.name === 'AbortError'");
  });

  it('非取消异常应显示错误消息', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain("message.error('执行失败: ' + (err instanceof Error ? err.message : String(err)))");
  });

  it('sendForegroundMessage 中 try-catch 应 reject 异常', () => {
    const source = readFileSync(hookPath, 'utf-8');
    expect(source).toContain('reject(err)');
  });
});
