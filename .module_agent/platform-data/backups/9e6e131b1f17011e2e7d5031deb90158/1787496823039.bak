    private Message buildMessage(long id, String role, String content, int seq) {
        Message msg = new Message();
        msg.setId(id);
        msg.setSessionId(10L);
        msg.setRole(role);
        msg.setContent(content);
        msg.setSequenceNum(seq);
        msg.setCreateTime(LocalDateTime.now());
        return msg;
    }

